# Copia este archivo como .env (en la raíz del repositorio) y completa los valores.
# .env está en .gitignore: NUNCA lo subas al repositorio.

# Fuentes de evidencia
GITHUB_TOKEN=
NOTION_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=

# LLM y observabilidad
GEMINI_API_KEY=
LANGSMITH_API_KEY=

# Base de datos PostgreSQL 16 (Neon Free o local)
# Formato: postgresql://usuario:clave@host:5432/basedatos?sslmode=require
DATABASE_URL=
