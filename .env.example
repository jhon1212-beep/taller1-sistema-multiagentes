# Base de datos PostgreSQL
# Formato: postgresql://usuario:clave@host:5432/basedatos?sslmode=require
DATABASE_URL=

# GitHub - EN-001 / HU-003: consultar commits
GITHUB_TOKEN=
GITHUB_ORG=curso-ingsoft-2026-II
GITHUB_API_URL=https://api.github.com

# Notion - EN-002 / HU-004: consultar tareas
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Bases de otros equipos (otro espacio de trabajo): JSON {"id de base": "token de su integracion"}
NOTION_TOKENS=

# Google Drive - HU-005 / decision SP-002
# Autenticacion mediante cuenta de servicio.
# Compartir la carpeta del proyecto con su correo como Lector.
# Configurar el adaptador con acceso de solo lectura.
# Acepta la ruta del archivo o el JSON completo (este ultimo para Render y GitHub Actions).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Gemini - SP-001
GEMINI_API_KEY=
# Completar con el identificador del modelo utilizado.
GEMINI_MODEL=

# LangSmith - SP-001: trazabilidad
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=grupo8-sp001

# Autenticacion docente - HU-001
# Secreto para firmar los JWT: minimo 32 caracteres aleatorios (no lo subas al repositorio).
JWT_SECRET=

# Validacion E2E - TA-021: actions (por defecto) | local | falso
E2E_EJECUTOR=actions
# Repositorio con .github/workflows/e2e.yml (formato propietario/repositorio) y su rama
GITHUB_REPO_E2E=
GITHUB_REF_E2E=main

# Supervision API - TA-022
SUPERVISION_SOURCES=dataset
SUPERVISION_EXPLAINER=template

# CP-10 con fuentes reales - TA-037
CP10_GITHUB_REPO=
CP10_CUTOFF=

# Corte diario - TA-033 (en GitHub van como Repository secrets)
CORTE_CORREO=
CORTE_CLAVE=
