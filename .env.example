# Base de datos PostgreSQL
# Formato: postgresql://usuario:clave@host:5432/basedatos?sslmode=require
DATABASE_URL=

# GitHub - EN-001 / HU-003: consultar commits
GITHUB_TOKEN=
GITHUB_ORG=curso-ingsoft-2026-II
GITHUB_API_URL=https://api.github.com

# Notion - EN-002 / HU-004: consultar tareas
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Google Drive - HU-005 / decision SP-002
# Autenticacion mediante cuenta de servicio.
# Compartir la carpeta del proyecto con su correo como Lector.
# Configurar el adaptador con acceso de solo lectura.
# Confirmar con el adaptador si la variable recibe una ruta o contenido JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Gemini - SP-001
GEMINI_API_KEY=
# Completar con el identificador del modelo utilizado.
GEMINI_MODEL=

# LangSmith - SP-001: trazabilidad
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=grupo8-sp001